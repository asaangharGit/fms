APP_NAME=FMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://fms.test

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fmsdb
DB_USERNAME=root
DB_PASSWORD=

SENDGRID_API_KEY=

FILESYSTEM_DRIVER=public
BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
CACHE_EXPIRE=-1

JWT_SECRET=

# General Ledger API (see docs/api/general-ledger/README.md)
API_REQUIRE_HTTPS=true
API_RATE_LIMIT_PER_MINUTE=120
API_MAX_FAILED_ATTEMPTS=10
API_ALLOW_QUERY_KEY=false
GL_API_POSTED_STATUSES=3
